{
  "name": "dynamic-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "build:analyze": "ANALYZE=1 npm run build",
    "build:local": "VITE_BASE_PATH=/ npm run build",
    "optimize:assets": "tsx scripts/optimize-assets.mts",
    "verify:home-copy": "tsx scripts/verify-home-copy.ts",
    "cms:bootstrap": "tsx scripts/bootstrap-cms.ts",
    "cms:verify": "tsx scripts/verify-supabase.ts",
    "cms:smoke": "tsx scripts/smoke-test-cms.ts",
    "cms:check-live": "tsx scripts/check-live.ts",
    "deploy:gh-pages": "bash scripts/deploy-gh-pages.sh",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.23.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "~5.7.0",
    "vite": "^5.4.11"
  }
}
